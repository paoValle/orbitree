{
  "name": "keplerk-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for keplerk — a local-first, agent-drivable Git client.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "mutate": "stryker run",
    "lint": "biome lint .",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "format": "biome check --write .",
    "cli": "node --experimental-strip-types packages/cli/src/index.ts",
    "desktop:dev": "pnpm --filter @keplerk/desktop run dev",
    "desktop:build": "pnpm --filter @keplerk/desktop run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
