{
  "name": "@orbitree/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "The desktop app. A window onto @orbitree/core, and nothing else.",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "e2e": "playwright test --grep-invert @perf",
    "e2e:perf": "playwright test performance.spec.ts",
    "package": "electron-vite build && electron-builder",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@orbitree/core": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "vite": "7.3.7"
  },
  "build": {
    "appId": "dev.orbitree.app",
    "productName": "orbitree",
    "files": [
      "out/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  }
}
